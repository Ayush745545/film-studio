# ─────────────────────────────────────────────────────────────
# AI FILM STUDIO — environment
# The app runs with ZERO configuration in Demo Mode.
# Every value below is optional.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
# Leave unset to use the built-in embedded file database (works instantly).
# Set to a PostgreSQL URL to use Prisma + PostgreSQL in production.
# DATABASE_URL="postgresql://user:pass@localhost:5432/aifilmstudio?schema=public"
# AFS_DB_DRIVER=auto            # auto | file | prisma
AFS_DATA_DIR=./.afs-data

# ── Object storage ──────────────────────────────────────────
AFS_STORAGE_DRIVER=local        # local | s3
AFS_STORAGE_DIR=./.afs-data/storage
# S3-compatible (MinIO, R2, S3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=aifilmstudio
# AWS_S3_ENDPOINT=https://s3.amazonaws.com
AFS_SIGNED_URL_TTL=900

# ── Security ────────────────────────────────────────────────
# REQUIRED in production. Used to encrypt user-owned provider API keys at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AFS_ENCRYPTION_KEY=dev-only-insecure-encryption-key-change-me
AFS_SESSION_SECRET=dev-only-insecure-session-secret-change-me
AFS_AUTH_MODE=open              # open (single local profile) | credentials
AFS_RATE_LIMIT_WINDOW_MS=60000
AFS_RATE_LIMIT_MAX=240

# ── Platform-owned provider keys (server-side only, never sent to browser) ──
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
# REPLICATE_API_TOKEN=
# FAL_KEY=
# ELEVENLABS_API_KEY=
# SUNO_API_KEY=
# COMFYUI_URL=http://127.0.0.1:8188
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── Queue / workers ─────────────────────────────────────────
AFS_QUEUE_DRIVER=memory         # memory | redis
# REDIS_URL=redis://localhost:6379
AFS_WORKER_CONCURRENCY=3
AFS_DEMO_MODE=auto              # auto | on | off

# ── Media ───────────────────────────────────────────────────
# Path to ffmpeg binary. Auto-detected from PATH when unset.
# FFMPEG_PATH=/usr/bin/ffmpeg
AFS_MAX_UPLOAD_MB=512

# ── Standalone media worker ─────────────────────────────────
# Set to "external" on the web process so heavy export/stems/bundle jobs are
# left queued for `npm run worker` instead of running inside the web process.
# AFS_WORKER_MODE=external
# AFS_WORKER_POLL_MS=1200

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
