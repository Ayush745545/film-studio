# ══════════════════════════════════════════════════════════════
#  Production environment for docker compose
#  Copy to .env and fill in real secrets. Never commit .env.
# ══════════════════════════════════════════════════════════════

# ── REQUIRED: generate strong values ─────────────────────────
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AFS_ENCRYPTION_KEY=
AFS_SESSION_SECRET=

# ── infrastructure passwords ─────────────────────────────────
POSTGRES_PASSWORD=
MINIO_ROOT_USER=afs
MINIO_ROOT_PASSWORD=
APP_PORT=3000

# ── auth ─────────────────────────────────────────────────────
# open        = single local profile (fastest to start, single operator)
# credentials = email + password, bcrypt, JWT in an httpOnly cookie
AFS_AUTH_MODE=credentials

# ── provider keys (all optional) ─────────────────────────────
# Without these the built-in Studio Engine renders previsualisation media.
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
REPLICATE_API_TOKEN=
FAL_KEY=
ELEVENLABS_API_KEY=
SUNO_API_KEY=
# Reachable local/self-hosted endpoints (only if the container can reach them):
# COMFYUI_URL=http://host.docker.internal:8188
# OLLAMA_BASE_URL=http://host.docker.internal:11434
