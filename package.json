{
  "name": "ai-film-studio",
  "version": "1.0.0",
  "private": true,
  "description": "AI Film Studio - an AI filmmaking operating system and professional non-linear video editor",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "worker": "node --env-file=.env --import tsx src/workers/runner.ts",
    "seed": "node --env-file=.env --import tsx scripts/seed.ts",
    "smoke": "node scripts/smoke.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:comfyui-real": "node --import tsx scripts/verify-comfyui-real.ts",
    "verify:open-api": "node --import tsx scripts/verify-open-api.ts",
    "check": "npm run verify && npm run typecheck",
    "build:standalone": "AFS_STANDALONE=1 next build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/s3-request-presigner": "^3.1139.0",
    "@tanstack/react-query": "^5.103.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "nanoid": "^5.1.16",
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "tailwindcss": "3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
